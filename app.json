    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-font",
      "expo-sharing"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "55a91194-1fab-4802-bf07-0eb4175d7d45"
      }
    }
  }
}
